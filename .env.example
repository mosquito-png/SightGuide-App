# ---------------------------------------------------------------------------
# SightGuide environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# is NEVER committed. The placeholders below are safe to commit.
#
# On a deployed host (Railway / Render / Fly / VPS) do NOT create a .env file.
# Instead set these same variables as environment variables (or secrets) on
# the host itself. The backend reads them with os.getenv, so no code change
# is needed - the values just have to be present at runtime.
# ---------------------------------------------------------------------------

# ---- Backend AI Providers & Secrets ---------------------------------------
# Primary AI Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback AI Provider: OpenAI (automatically used if Gemini fails or times out)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=8.0

SIGHTGUIDE_API_KEY=

# Google Maps (used by the navigation / maps features)
GOOGLE_MAPS_API_KEY=
# Create a Map ID in Google Cloud Console (Maps JavaScript API -> Map IDs).
# Needed only for Advanced Markers. If empty, markers are skipped.
GOOGLE_MAPS_MAP_ID=

# MongoDB connection string. In Docker the compose file overrides this.
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=sightguide

# Optional Redis. If empty/unreachable the app falls back to in-memory cache.
REDIS_URL=redis://localhost:6379/0

# ---- App behaviour ---------------------------------------------------------
ENVIRONMENT=development
AUTH_ENABLED=false
TOOL_TIMEOUT_SECONDS=8
MAX_RETRIES=2

# Comma-separated list of allowed browser origins (CORS).
# IMPORTANT on deploy: set this to your real frontend URL, e.g.
#   CORS_ORIGINS=https://sightguide.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1,capacitor://localhost,ionic://localhost,https://localhost

# ---- Frontend (Vercel / Netlify) -------------------------------------------
# Set these as build-time env vars in your hosting dashboard, NOT in .env.
# VITE_API_URL must point at the deployed backend, e.g.
#   VITE_API_URL=https://your-backend-host.example.com/api
VITE_API_URL=http://localhost:8000/api
VITE_GOOGLE_MAPS_API_KEY=
